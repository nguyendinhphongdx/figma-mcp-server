{
  "name": "figma-mcp-server",
  "version": "0.1.0",
  "description": "Self-hosted, read-only Figma MCP server (Streamable HTTP) with rate-limit governor, shared cache and bulk frame export.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "bin": {
    "fmcp": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"try{require('fs').chmodSync('dist/cli.js',0o755)}catch{}\"",
    "start": "node dist/main.js",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "key:generate": "tsx scripts/generate-api-key.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fflate": "^0.8.3",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
