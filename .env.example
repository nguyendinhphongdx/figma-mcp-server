# Copy to .env for local development (`npm run dev`). In production inject these as real
# environment variables / secrets; never commit the real file.

# --- required -----------------------------------------------------------------------------
# Externally visible origin of this server. Download links and the Admin UI URL are built from it.
PUBLIC_BASE_URL=http://localhost:3000
# >= 32 random characters, e.g. `openssl rand -base64 48`. Signs download links.
# `fmcp init` generates this for you automatically.
DOWNLOAD_SIGNING_SECRET=

# --- optional: only used to seed the Admin UI on first run ---------------------------------
# Once the server has started once, the Figma token and users are managed at `PUBLIC_BASE_URL/`
# (Admin UI) instead — these two are just a convenience for scripted/non-interactive deployments.
# Figma personal access token of a service account (scopes: file_content:read, file_comments:read,
# library_content:read). Every MCP user shares this identity; see FIGMA_ALLOWED_FILE_KEYS.
FIGMA_TOKEN=
# name=<sha256 of the key>, comma separated. Create entries with: npm run key:generate -- <name>
MCP_API_KEYS=

# --- strongly recommended -----------------------------------------------------------------
# Only these files are reachable (comma separated file keys). Empty = everything the token can open.
FIGMA_ALLOWED_FILE_KEYS=

# --- optional (defaults shown) ------------------------------------------------------------
# HOST=0.0.0.0
# PORT=3000
# LOG_LEVEL=info
# DATA_DIR=./data
# ALLOWED_ORIGINS=                      # browser origins allowed to call /mcp; empty rejects any Origin header
# REQUESTS_PER_MINUTE_PER_USER=120

# Figma budget the governor paces itself to (per minute). Defaults suit a Professional Dev/Full seat;
# raise them on Organization/Enterprise plans, lower them for View/Collab seats.
# FIGMA_TIER1_RPM=10                    # files, nodes, images
# FIGMA_TIER2_RPM=25                    # comments
# FIGMA_TIER3_RPM=50                    # styles, components
# FIGMA_MAX_QUEUE_WAIT_SECONDS=20       # longest a call waits for a free slot before failing fast
# FIGMA_MAX_RETRY_AFTER_WAIT_SECONDS=60 # a 429 with a longer Retry-After opens the circuit instead of waiting
# Figma bills GET /v1/files by response size, not by request count, so a big response is charged
# extra slots: one per this many bytes. Lower it if deep reads keep provoking 429s.
# FIGMA_COST_BYTES_PER_UNIT=524288      # 512 KiB

# CACHE_TTL_STRUCTURE_SECONDS=600
# CACHE_TTL_COMMENTS_SECONDS=120
# EXPORT_MAX_NODES=300
# EXPORT_BATCH_SIZE=100
# EXPORT_DOWNLOAD_CONCURRENCY=5
# EXPORT_RETENTION_HOURS=24
# DOWNLOAD_URL_TTL_SECONDS=3600
# IMAGE_HOST_ALLOWLIST=amazonaws.com,figma.com
